# ---- Supabase ----
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- NextAuth ----
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Administradores da loja ----
# E-mails (separados por vírgula) que têm acesso ao painel /admin
ADMIN_EMAILS=gordinho@admin.com

# ---- Mercado Pago ----
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=

# ---- E-mails de pedido (Pix, pagamento aprovado, status) via SMTP ----
# Pode ser o mesmo Gmail + senha de app configurado no SMTP do Supabase.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seuemail@gmail.com
SMTP_PASS=
# Opcional: remetente (padrão: "Nome da loja <SMTP_USER>")
EMAIL_FROM=

# ---- URL pública da aplicação (usada nos links de retorno do Mercado Pago) ----
APP_URL=http://localhost:3000

# ---- Aviso de pedido pago no WhatsApp da loja (serviço whatsapp-alert, no Railway) ----
# Veja whatsapp-alert/README.md
WHATSAPP_ALERT_URL=
WHATSAPP_ALERT_TOKEN=

# ---- Cron diário (vercel.json → /api/cron/keep-alive) ----
# Mantém o Supabase grátis ativo (ele pausa após 7 dias sem uso). Uma senha
# qualquer; a Vercel manda ela sozinha nas chamadas do cron.
CRON_SECRET=

# Google reCAPTCHA v3 (invisível) no login, cadastro e checkout.
# Crie em https://www.google.com/recaptcha/admin → tipo "Pontuação (v3)",
# domínio do site (ex.: site-gordinho.vercel.app). Sem estas duas variáveis
# o reCAPTCHA fica desligado. Depois de adicionar na Vercel, faça Redeploy.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Opcional: nota mínima (0 a 1) pra considerar humano. Padrão 0.5.
# RECAPTCHA_MIN_SCORE=0.5
